# /etc/nginx/sites-available/default

server {
    listen 80;
    server_name schepka26.ru www.schepka26.ru; # Не факт, что нужно

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name schepka26.ru;
    ssl_certificate /etc/letsencrypt/live/schepka26.ru/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/schepka26.ru/privkey.pem; # managed by Certbot
    access_log  /var/log/nginx/example.log;

    location /static/ {
        root /root/site/sudoku;
        expires 30d;
    }

    location /ws/sudoku/ {
        proxy_pass http://127.0.0.1:8000/ws/sudoku/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
        proxy_connect_timeout 86400;
        proxy_send_timeout 86400;
    }

    location /ws/voice/ {
        proxy_pass http://127.0.0.1:8000/ws/voice/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
        proxy_connect_timeout 86400;
        proxy_send_timeout 86400;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $server_name;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    listen 3478;
    location / {
        proxy_pass http://localhost:3478;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    listen 5349;
    location / {
        proxy_pass http://localhost:5349;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}